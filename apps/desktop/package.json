{
  "name": "@interview-copilot/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:sidecar": "cargo build --release --manifest-path ../../crates/audio-sidecar/Cargo.toml",
    "build:capture-helper": "cargo build --release --manifest-path ../../tools/capture-helper/Cargo.toml",
    "package:win": "npm run build:sidecar && npm run build:capture-helper && npm run build && electron-builder --win",
    "smoke:production": "npm run build && node scripts/production-smoke.mjs",
    "capture-protection:smoke": "npm run build:capture-helper && npm run build && node scripts/capture-protection-smoke.mjs",
    "visual:smoke": "npm run build && node scripts/visual-smoke.mjs",
    "functional:e2e": "npm run build && node scripts/functional-e2e.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@interview-copilot/protocol": "0.1.0",
    "@interview-copilot/shared": "0.1.0",
    "@types/sql.js": "^1.4.11",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.14.2",
    "ws": "^8.18.3",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "37.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.interviewcopilot.desktop",
    "productName": "Interview Copilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../crates/audio-sidecar/target/release/interview-audio.exe",
        "to": "audio-sidecar/interview-audio.exe"
      },
      {
        "from": "../../tools/capture-helper/target/release/capture-helper.exe",
        "to": "capture-helper/capture-helper.exe"
      },
      {
        "from": "../../node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql.js/sql-wasm.wasm"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
