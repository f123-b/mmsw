{
  "name": "@interview-copilot/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:sidecar": "cargo build --release --manifest-path ../../crates/audio-sidecar/Cargo.toml",
    "package:win": "npm run build:sidecar && npm run build && electron-builder --win",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@interview-copilot/protocol": "0.1.0",
    "@interview-copilot/shared": "0.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.interviewcopilot.desktop",
    "productName": "Interview Copilot",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "extraResources": [
      {
        "from": "../../crates/audio-sidecar/target/release/interview-audio.exe",
        "to": "audio-sidecar/interview-audio.exe"
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
