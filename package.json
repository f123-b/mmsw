{
  "name": "interview-copilot",
  "private": true,
  "version": "0.1.0",
  "description": "Realtime interview copilot desktop application",
  "workspaces": [
    "apps/asr-gateway",
    "apps/desktop",
    "packages/protocol",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm --workspace apps/desktop run dev",
    "build": "npm --workspace apps/desktop run build",
    "package:win": "npm run prepare:question-classifier && npm run ensure:electron-runtime && npm --workspace apps/desktop run package:win",
    "prepare:question-classifier": "node tools/question-classifier/prepare-model.mjs",
    "ensure:electron-runtime": "node tools/ensure-electron-runtime.mjs",
    "smoke:production": "npm --workspace apps/desktop run smoke:production",
    "capture-protection:smoke": "npm --workspace apps/desktop run capture-protection:smoke",
    "audio:windows:smoke": "npm --workspace apps/desktop run audio:windows:smoke",
    "capture-helper:build": "npm --workspace apps/desktop run build:capture-helper",
    "verify:windows-native": "npm --workspace apps/desktop run verify:windows-native",
    "performance:smoke": "npm --workspace apps/desktop run performance:smoke",
    "visual:smoke": "npm --workspace apps/desktop run visual:smoke",
    "functional:e2e": "npm run ensure:electron-runtime && npm --workspace apps/desktop run functional:e2e",
    "realtime:smoke": "npm run ensure:electron-runtime && npm --workspace @interview-copilot/desktop run realtime:smoke",
    "screenshot:smoke": "npm run ensure:electron-runtime && npm --workspace @interview-copilot/desktop run screenshot:smoke",
    "probe-failure:e2e": "npm run ensure:electron-runtime && npm --workspace apps/desktop run probe-failure:e2e",
    "shutdown-process:e2e": "npm run ensure:electron-runtime && npm --workspace apps/desktop run shutdown-process:e2e",
    "verify:package": "node apps/desktop/scripts/verify-package.mjs",
    "test": "npm run test --workspaces --if-present",
    "benchmark:question": "npm --workspace @interview-copilot/shared run benchmark:question",
    "benchmark:project-analysis": "npm --workspace @interview-copilot/shared run benchmark:project-analysis",
    "benchmark:project-comprehension": "npm --workspace @interview-copilot/shared run benchmark:project-comprehension",
    "benchmark:project-semantic-intelligence": "npm --workspace @interview-copilot/shared run benchmark:project-semantic-intelligence",
    "benchmark:real-interview": "npm --workspace @interview-copilot/shared run benchmark:real-interview",
    "benchmark:realtime-runtime": "npm --workspace @interview-copilot/desktop run benchmark:realtime-runtime",
    "benchmark:screenshot-vision": "npm --workspace @interview-copilot/desktop run benchmark:screenshot-vision",
    "test:soak": "npm --workspace @interview-copilot/desktop run test:soak",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "electron": "43.4.1"
  }
}
