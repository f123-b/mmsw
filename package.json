{
  "name": "interview-copilot",
  "private": true,
  "version": "0.1.0",
  "description": "Realtime interview copilot desktop application",
  "workspaces": [
    "apps/asr-gateway",
    "apps/desktop",
    "packages/protocol",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm --workspace apps/desktop run dev",
    "build": "npm --workspace apps/desktop run build",
    "package:win": "npm --workspace apps/desktop run package:win",
    "smoke:production": "npm --workspace apps/desktop run smoke:production",
    "capture-protection:smoke": "npm --workspace apps/desktop run capture-protection:smoke",
    "capture-helper:build": "npm --workspace apps/desktop run build:capture-helper",
    "visual:smoke": "npm --workspace apps/desktop run visual:smoke",
    "functional:e2e": "npm --workspace apps/desktop run functional:e2e",
    "probe-failure:e2e": "npm --workspace apps/desktop run probe-failure:e2e",
    "shutdown-process:e2e": "npm --workspace apps/desktop run shutdown-process:e2e",
    "verify:package": "node apps/desktop/scripts/verify-package.mjs",
    "test": "npm run test --workspaces --if-present",
    "benchmark:question": "npm --workspace @interview-copilot/shared run benchmark:question",
    "test:soak": "npm --workspace @interview-copilot/desktop run test:soak",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "electron": "43.4.1"
  }
}
